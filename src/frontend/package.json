{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200 --proxy-config proxy.conf.json",
    "start:local": "ng serve --host 0.0.0.0 --port 4200 --proxy-config proxy.conf.json --open",
    "start:web": "ng serve --host 0.0.0.0 --port 4200 --proxy-config proxy.conf.json",
    "start:api": "ASPNETCORE_ENVIRONMENT=Development DOTNET_ENVIRONMENT=Development dotnet run --project ../backend/ProductionLinePlanner.Api/ProductionLinePlanner.Api.csproj --urls http://0.0.0.0:9000",
    "start:full": "concurrently -k -n API,WEB \"npm run start:api\" \"npm run start:web\"",
    "build": "ng build",
    "build:prod:frontend": "node ../../scripts/build-iis-production.mjs frontend",
    "publish:prod:backend": "node ../../scripts/build-iis-production.mjs backend",
    "build:prod:iis": "node ../../scripts/build-iis-production.mjs all",
    "deploy:prod:iis": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/deploy-iis-production.ps1",
    "verify:prod:iis": "node ../../scripts/verify-iis-production.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:visual": "playwright test --config=playwright.config.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/cdk": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@fontsource/cairo": "^5.2.7",
    "@microsoft/signalr": "^8.0.17",
    "primeflex": "^3.3.1",
    "primeicons": "^7.0.0",
    "primeng": "^17.18.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.12",
    "@angular/cli": "^17.3.12",
    "@angular/compiler-cli": "^17.3.0",
    "@playwright/test": "^1.61.1",
    "@types/jasmine": "~5.1.0",
    "concurrently": "^9.2.1",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.4.2"
  }
}
