{
  "TimeZones": {
    "Cairo": "Egypt Standard Time"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://dayoub.local"
    ],
    "AllowInsecureHttpOrigins": true,
    "AllowCredentials": true
  },
